{
  "scripts": {
    "settings:gen": "cargo run --manifest-path ../Cargo.toml -p aube-settings --bin generate-settings-docs",
    "error-codes:gen": "cargo run --manifest-path ../Cargo.toml -p aube-codes --bin generate-error-codes-docs",
    "data:gen": "npm run settings:gen && npm run error-codes:gen",
    "docs:dev": "npm run data:gen && vitepress dev",
    "docs:build": "node --test .vitepress/social-images.test.mjs && npm run data:gen && vitepress build && node .vitepress/check-social-images.mjs .vitepress/dist && npm run docs:check",
    "docs:preview": "vitepress preview",
    "icons:render": "node scripts/render-icons.mjs",
    "docs:check": "node ../scripts/check-docs.mjs"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  },
  "aube": {
    "allowBuilds": {
      "esbuild": true,
      "sharp": true
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "sharp": "^0.35.0",
    "vitepress": "^1.5.0"
  }
}
